{
  "name": "@roobli/md",
  "version": "0.1.7",
  "description": "WYSIWYG-first markdown engine for Noto — block-oriented, byte-exact friendly, fast on large vaults.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "roobli",
  "homepage": "https://github.com/roobli/md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roobli/md.git"
  },
  "bugs": {
    "url": "https://github.com/roobli/md/issues"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legacy-micromark": {
      "types": "./dist/legacy-micromark.d.ts",
      "import": "./dist/legacy-micromark.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "bench:ab": "pnpm build && node scripts/bench-ab.mjs"
  },
  "dependencies": {
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-to-markdown-cjk-friendly": "^1.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "mdast-util-from-markdown": "^2.0.2",
    "micromark-extension-cjk-friendly": "^1.2.3",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0"
  }
}
